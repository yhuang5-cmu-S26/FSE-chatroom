PORT=3001
DB_DRIVER=json
MONGODB_URI=mongodb://127.0.0.1:27017/esn_chatroom
CORS_ORIGIN=https://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
SPEED_TEST_PROVIDER=local-http-health
SPEED_TEST_MAX_CONCURRENCY=30
SPEED_TEST_MAX_DURATION_SECONDS=15
LLM_API_URL=https://your-llm-provider.example/v1/chat/completions
LLM_API_KEY=replace-with-your-server-side-key
LLM_MODEL=your-model-name
LLM_TIMEOUT_MS=15000
LLM_STRUCTURED_OUTPUTS=false
# Enable only when the OpenAI-compatible provider emits a final usage SSE chunk.
LLM_STREAM_INCLUDE_USAGE=false
# Dangerous tool approvals expire instead of remaining reusable indefinitely.
AGENT_TOOL_APPROVAL_TTL_MS=600000
# JSON mock storage. Set DB_DRIVER=mongodb to use the schemas in MongoDB.
JSON_DATA_DIR=./tmp/mock-data
AGENT_SESSION_DATA_DIR=./tmp/llm-session
WORKFLOW_DATA_DIR=./tmp/workflow-data
# Rolling memory compacts only after this approximate token threshold.
AGENT_MEMORY_TRIGGER_TOKENS=6000
# Recent messages remain verbatim within both limits.
AGENT_MEMORY_KEEP_TOKENS=3000
AGENT_MEMORY_MAX_RECENT_MESSAGES=24
# One incremental-summary call may generate at most this many tokens. The
# character limit is a second guard matching the persisted summary field.
AGENT_MEMORY_SUMMARY_TOKENS=800
AGENT_MEMORY_SUMMARY_CHARS=4000
AGENT_MEMORY_SUMMARY_TIMEOUT_MS=15000
MCP_CONNECT_TIMEOUT_MS=5000
MCP_TOOL_TIMEOUT_MS=12000
# Only idempotent/read-only MCP calls opt into bounded transient retries.
MCP_READ_MAX_ATTEMPTS=3
MCP_RETRY_BASE_DELAY_MS=1000
MCP_WEATHER_URL=
MCP_WEATHER_TOKEN=
MCP_WEATHER_TOOL=weather_forecast
