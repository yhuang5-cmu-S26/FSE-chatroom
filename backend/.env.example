PORT=3001
DB_DRIVER=json
MONGODB_URI=mongodb://127.0.0.1:27017/esn_chatroom
CORS_ORIGIN=https://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
SPEED_TEST_PROVIDER=local-synthetic
LLM_API_URL=https://your-llm-provider.example/v1/chat/completions
LLM_API_KEY=replace-with-your-server-side-key
LLM_MODEL=your-model-name
LLM_TIMEOUT_MS=15000
LLM_STRUCTURED_OUTPUTS=false
LLM_SESSION_DATA_DIR=./tmp/llm-session
# Number of newest user/assistant turns kept verbatim in the planner prompt.
AGENT_CONTEXT_RECENT_MESSAGES=6
# Maximum characters reserved for deterministic compressed memory of older turns.
AGENT_CONTEXT_SUMMARY_CHARS=3600
